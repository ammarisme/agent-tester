# Copy to .env. Every variable is optional; defaults are shown.
# Full reference: docs/deployment.md

# ── Secrets your agent contracts reference as ${NAME} ─────────────────
# Values live only in the runner's environment, never in the database.
AGENT_API_KEY=

# Restrict which variables contracts may read (regex, full match).
# Recommended in shared deployments, e.g. AGENT_.*|LLM_.*
# AGENT_TESTER_SECRET_PATTERN=

# ── Access ────────────────────────────────────────────────────────────
# When set, the API requires "Authorization: Bearer <token>". The bundled UI
# attaches it automatically, so also protect the UI (SSO proxy, VPN).
# API_TOKEN=

# ── Ports on the host ─────────────────────────────────────────────────
# UI_PORT=3000
# API_PORT=8000
# MOCK_PORT=9999

# ── Execution ─────────────────────────────────────────────────────────
# Runs executing at once; the rest wait as "queued".
# MAX_CONCURRENT_RUNS=2
# Max seconds for the "Send test request" button in the agent editor.
# TEST_REQUEST_TIMEOUT_S=30
# Accept credential-looking literals in contract headers (not recommended).
# ALLOW_LITERAL_SECRETS=false
# Where the demo agents point (default: the bundled mock-agent service).
# DEMO_AGENT_URL=http://mock-agent:9999

# ── Misc ──────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# MAX_UPLOAD_MB=20
# Only needed if another origin calls the API directly from a browser.
# CORS_ORIGINS=
