{
  "$defs": {
    "InvokeSpec": {
      "additionalProperties": false,
      "description": "How to call the agent for one case.",
      "properties": {
        "method": {
          "default": "POST",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "url": {
          "description": "Target URL. Supports {{ templates }}.",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "body_template": {
          "default": null,
          "description": "JSON body. Strings inside are templates; a lone '{{ expr }}' keeps its type.",
          "title": "Body Template"
        },
        "timeout_s": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "url"
      ],
      "title": "InvokeSpec",
      "type": "object"
    },
    "PollSpec": {
      "additionalProperties": false,
      "description": "Optional second phase for agents that accept work and finish later.",
      "properties": {
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "POST"
          ],
          "title": "Method",
          "type": "string"
        },
        "url_template": {
          "minLength": 1,
          "title": "Url Template",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "body_template": {
          "default": null,
          "title": "Body Template"
        },
        "interval_s": {
          "default": 2,
          "maximum": 600,
          "minimum": 0.05,
          "title": "Interval S",
          "type": "number"
        },
        "timeout_s": {
          "default": 600,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout S",
          "type": "number"
        },
        "done_when": {
          "description": "Predicate on the poll response, e.g. \"status in ['COMPLETED','FAILED']\".",
          "minLength": 1,
          "title": "Done When",
          "type": "string"
        },
        "failed_when": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "status in ['FAILED','ERROR','CANCELLED']",
          "description": "Predicate that marks a terminal response as an agent failure.",
          "title": "Failed When"
        },
        "extract": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Extract",
          "type": "object"
        }
      },
      "required": [
        "url_template",
        "done_when"
      ],
      "title": "PollSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Declarative HTTP contract: invoke, optionally poll, then extract fields.",
  "properties": {
    "invoke": {
      "$ref": "#/$defs/InvokeSpec"
    },
    "poll": {
      "anyOf": [
        {
          "$ref": "#/$defs/PollSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "extract": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Field name \u2192 JSONPath. 'final_text' is scored; numeric fields become metrics.",
      "title": "Extract",
      "type": "object"
    }
  },
  "required": [
    "invoke"
  ],
  "title": "AgentContract",
  "type": "object"
}
